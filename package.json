{
  "name": "jsx-object",
  "version": "1.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Tiny, dependency-free JSX runtime that turns JSX into plain JavaScript objects, with async components. Great for server-driven UI and JSON templating.",
  "keywords": [
    "jsx",
    "tsx",
    "jsx-runtime",
    "json",
    "object",
    "template",
    "templating",
    "server-driven-ui",
    "sdui",
    "async",
    "components",
    "typescript"
  ],
  "author": "Guilherme Chaguri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guichaguri/jsx-object.git"
  },
  "homepage": "https://github.com/Guichaguri/jsx-object#readme",
  "bugs": {
    "url": "https://github.com/Guichaguri/jsx-object/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jsx-dev-runtime": {
      "import": "./dist/jsx-dev-runtime.js",
      "require": "./dist/jsx-dev-runtime.cjs"
    },
    "./jsx-runtime": {
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --coverage.include=src/**"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
